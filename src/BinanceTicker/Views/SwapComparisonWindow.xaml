<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BinanceTicker.Views.SwapComparisonWindow"
        Title="換幣比較" Icon="/BinanceTicker;component/Assets/app.ico"
        Width="1100" Height="780" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Difference" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Direction}" Value="1">
                        <Setter Property="Foreground" Value="{DynamicResource ThemePositive}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Direction}" Value="-1">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeNegative}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Difference}">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="QuoteValue" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="Margin" Value="0,10,0,0"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StateLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Result.IsStale}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FormulaDisclosure" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Padding="0,6" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="›" FontSize="17" Width="18" VerticalAlignment="Center"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="⌄"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter Content="{TemplateBinding Header}"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" Margin="18,8,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="換幣比較" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="以原幣為基準比較多筆換幣。選取查看詳情，雙擊編輯。" Style="{StaticResource Label}" Margin="0,8,0,12"/>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="新增" Command="{Binding NewCommand}" Margin="0,0,8,8" Style="{StaticResource SettingsPrimaryButton}"/>
                <Button Content="結算" Command="{Binding SettleCommand}" Margin="0,0,8,8"/>
                <Button Content="編輯" Command="{Binding EditCommand}" Margin="0,0,8,8"/>
                <Button Content="{Binding Selected.ToggleText, FallbackValue=啟用／停用}" Command="{Binding ToggleCommand}" Margin="0,0,8,8"/>
                <Button Content="刪除" Click="DeleteClicked" x:Name="DeleteButton" Margin="0,0,8,8"/>
                <Button Content="移除所有損壞紀錄" Click="RemoveInvalidClicked" Visibility="{Binding HasInvalid, Converter={StaticResource VisibleWhenTrue}}"/>
            </WrapPanel>
        </StackPanel>
        <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding ViewIndex, Mode=TwoWay}" Margin="0,0,0,12" AutomationProperties.Name="換幣紀錄分類">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True" /></ControlTemplate></TabControl.Template>
            <TabItem Header="{Binding ActiveHeader}" Style="{StaticResource SettingsTab}" />
            <TabItem Header="{Binding HistoryHeader}" Style="{StaticResource SettingsTab}" />
        </TabControl>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ResultHeading}" Style="{StaticResource Label}" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeNegative}" TextWrapping="Wrap"/>
            <TextBlock Text="相較繼續持有原幣 · 報價結算未扣費用，實際成交以到帳數量為準 · 各筆獨立比較" Style="{StaticResource Label}" FontSize="11" Margin="0"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>
            <Grid>
                <DataGrid x:Name="RecordsGrid" ItemsSource="{Binding VisibleRecords}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SettingsBorder}" Background="{DynamicResource SettingsSurface}" Foreground="{DynamicResource SettingsText}" BorderBrush="{DynamicResource SettingsBorder}" RowHeight="44" ColumnHeaderHeight="38" EnableRowVirtualization="True" EnableColumnVirtualization="False" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="RecordDoubleClicked" PreviewKeyDown="RecordsKeyDown" AutomationProperties.Name="換幣紀錄">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar"/>
                        <Style x:Key="TableText" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SettingsInput}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SettingsRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SettingsRowSelected}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SettingsText}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="換幣／結算時間" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource TableText}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="換出 → 換入" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TableText}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="換回原幣數量" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnText}" Style="{StaticResource TableText}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="原幣差額" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuantityDifferenceText}" Style="{StaticResource Difference}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="USDT 差額" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UsdtDifferenceText}" Style="{StaticResource Difference}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="報酬率" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnPercentText}" Style="{StaticResource Difference}" Margin="10,0" VerticalAlignment="Center" ToolTip="{Binding ExactResultsText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="狀態" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource StateLabel}" Margin="10,0" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding QuotesText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="20,60,20,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}"/>
            </Grid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SettingsBorder}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,2,0,0" x:Name="DetailPanel" DataContext="{Binding Selected}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <UniformGrid Columns="4" Margin="0,0,0,16" ToolTip="{Binding ExactResultsText}">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding ReturnLabel}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ReturnText}" Style="{StaticResource QuoteValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="原幣差額" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding QuantityDifferenceText}" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="USDT 差額" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding UsdtDifferenceText}" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="相對報酬率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ReturnPercentText}" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid ToolTip="{Binding ExactResultsText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FromValueLabel}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FromValueText}" Style="{StaticResource QuoteValue}" FontSize="18"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding ToValueLabel}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ToValueText}" Style="{StaticResource QuoteValue}" FontSize="18"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SettingsBorder}" Margin="0,12,0,10"/>
                        <Grid ToolTip="{Binding QuotesText}" Visibility="{Binding IsOpen, Converter={StaticResource VisibleWhenTrue}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FromAsset, StringFormat='{}{0} 現價'}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FromQuoteText}" Style="{StaticResource QuoteValue}"/>
                                <TextBlock Text="{Binding FromQuoteTimeText}" Style="{StaticResource MetricLabel}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding ToAsset, StringFormat='{}{0} 現價'}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding ToQuoteText}" Style="{StaticResource QuoteValue}"/>
                                <TextBlock Text="{Binding ToQuoteTimeText}" Style="{StaticResource MetricLabel}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Expander Header="計算方式" Style="{StaticResource FormulaDisclosure}" Margin="0,12,0,0" AutomationProperties.Name="計算方式">
                            <TextBlock Text="{Binding FormulaText}" Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap"/>
                        </Expander>
                        <StackPanel Visibility="{Binding HasSettlements, Converter={StaticResource VisibleWhenTrue}}" Margin="0,16,0,0">
                            <TextBlock Text="結算明細" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SettlementSummary}" Style="{StaticResource Label}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding SettlementRows}" AutomationProperties.Name="結算明細">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,12" ToolTip="{Binding SnapshotText}">
                                        <StackPanel>
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Foreground="{DynamicResource SettingsAccent}" /><TextBlock Text="{Binding TimeText}" Style="{StaticResource MetricLabel}" /></DockPanel>
                                            <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Difference}" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="{Binding NoteText}" Style="{StaticResource OptionalText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding Setting.Note}" Style="{StaticResource OptionalText}"/>
                        <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource ThemeNegative}" Style="{StaticResource OptionalText}"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
