<Window x:Class="BinanceTicker.Views.SwapComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="換幣比較" Icon="/BinanceTicker;component/Assets/app.ico"
        Width="820" Height="740" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" /><Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Difference" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Direction}" Value="1"><Setter Property="Foreground" Value="{DynamicResource ThemePositive}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Direction}" Value="-1"><Setter Property="Foreground" Value="{DynamicResource ThemeNegative}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RecordCard" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SettingsAccent}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsRowHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Difference}">
                <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="QuoteValue" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Label}">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="StateLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers><DataTrigger Binding="{Binding Result.IsStale}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeWarning}" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="FormulaDisclosure" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      HorizontalContentAlignment="Left" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0"
                                      Padding="0,6" Cursor="Hand">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Arrow" Text="›" FontSize="17" Width="18" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄" /></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding Header}" />
                        </ToggleButton>
                        <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" Margin="18,8,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="換幣比較" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="以原幣為基準，查看這次換幣的相對表現。" Style="{StaticResource Label}" Margin="0,8,0,12" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="新增" Command="{Binding NewCommand}" Margin="0,0,8,8" Style="{StaticResource SettingsPrimaryButton}" />
                <Button Content="編輯" Command="{Binding EditCommand}" Margin="0,0,8,8" />
                <Button Content="{Binding Selected.ToggleText, FallbackValue=啟用／停用}" Command="{Binding ToggleCommand}" Margin="0,0,8,8" />
                <Button Content="刪除" Click="DeleteClicked" x:Name="DeleteButton" Margin="0,0,8,8" />
                <Button Content="移除所有損壞紀錄" Click="RemoveInvalidClicked" Visibility="{Binding HasInvalid, Converter={StaticResource VisibleWhenTrue}}" />
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeNegative}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                <Button Content="取消編輯" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Content="儲存紀錄" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" />
            </StackPanel>
            <TextBlock Text="相較繼續持有原幣 · 未扣除換回費用 · 各筆獨立比較" Style="{StaticResource Label}" FontSize="11" Margin="0" />
        </StackPanel>
        <ScrollViewer x:Name="ComparisonScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="尚未建立紀錄。按「新增」記下你的一次換幣。" TextWrapping="Wrap" Margin="0,8,0,16"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                <ListBox ItemsSource="{Binding Records}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="300"
                         Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource SettingsText}" ItemContainerStyle="{StaticResource RecordCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="換幣紀錄">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding ExactResultsText}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MetricLabel}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SettingsInput}" CornerRadius="10" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource StateLabel}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="現在可換回" Style="{StaticResource MetricLabel}" Margin="0,18,0,4" />
                                <TextBlock Text="{Binding ReturnText}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Border Height="1" Background="{DynamicResource SettingsBorder}" Margin="0,16,0,14" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="原幣差額" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding QuantityDifferenceText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="USDT 差額" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding UsdtDifferenceText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="相對報酬率" Style="{StaticResource MetricLabel}" />
                                        <TextBlock Text="{Binding ReturnPercentText}" Style="{StaticResource MetricValue}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="18" Margin="0,2,0,0" DataContext="{Binding Selected}">
                    <StackPanel>
                        <TextBlock Text="市值比較" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <Grid ToolTip="{Binding ExactResultsText}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FromAsset, StringFormat=原幣若持有至今 · {0}}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding FromValueText}" Style="{StaticResource QuoteValue}" FontSize="18" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding ToAsset, StringFormat=換入幣現在市值 · {0}}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding ToValueText}" Style="{StaticResource QuoteValue}" FontSize="18" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SettingsBorder}" Margin="0,16,0,14" />
                        <Grid ToolTip="{Binding QuotesText}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding FromAsset, StringFormat='{}{0} 現價'}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding FromQuoteText}" Style="{StaticResource QuoteValue}" />
                                <TextBlock Text="{Binding FromQuoteTimeText}" Style="{StaticResource MetricLabel}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding ToAsset, StringFormat='{}{0} 現價'}" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding ToQuoteText}" Style="{StaticResource QuoteValue}" />
                                <TextBlock Text="{Binding ToQuoteTimeText}" Style="{StaticResource MetricLabel}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                        <Expander Header="計算方式" Style="{StaticResource FormulaDisclosure}" Margin="0,12,0,0" AutomationProperties.Name="計算方式">
                            <TextBlock Text="{Binding FormulaText}" Foreground="{DynamicResource SettingsMuted}" TextWrapping="Wrap" />
                        </Expander>
                        <TextBlock Text="{Binding Setting.Note}" Style="{StaticResource OptionalText}" />
                        <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource ThemeNegative}" Style="{StaticResource OptionalText}" />
                    </StackPanel>
                </Border>
                <Border x:Name="EditorPanel" Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,12,0,0" IsEnabled="{Binding EditorEnabled}"
                        Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="換出幣種（原幣）" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding FromSymbolText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="換出幣種" />
                                <TextBlock Text="換出前的數量" Style="{StaticResource Label}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding FromQuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="換出數量" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="換入幣種" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding ToSymbolText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="換入幣種" />
                                <TextBlock Text="實際換入數量（到帳）" Style="{StaticResource Label}" Margin="0,12,0,6" />
                                <TextBox Text="{Binding ToQuantityText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="實際換入數量" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="例如：100 NEAR → 20 QNT。數量大於零，小數點使用 .，不使用千分位逗號。" Style="{StaticResource Label}" Margin="0,10,0,12" />
                        <TextBlock Text="換幣時間（本機時間，yyyy-MM-dd HH:mm:ss）" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding SwappedAtText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="換幣時間" />
                        <TextBlock Text="備註（選填）" Style="{StaticResource Label}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="換幣備註" />
                        <CheckBox Content="啟用追蹤" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
