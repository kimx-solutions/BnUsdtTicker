<Window x:Class="BinanceTicker.Views.PriceAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BinanceTicker.Core.ViewModels;assembly=BinanceTicker.Core"
        Title="價格警示" Icon="/BinanceTicker;component/Assets/app.ico"
        Width="480" Height="760" MinWidth="360" MinHeight="320"
        WindowStartupLocation="Manual" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:AlertPolicyEditorViewModel}">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="提醒策略" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedValuePath="Value" SelectedValue="{Binding Strategy}" AutomationProperties.Name="提醒策略" MinHeight="32"
                              Foreground="{DynamicResource SettingsText}" Background="{DynamicResource SettingsInput}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsRepeat}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="冷卻時間 · 分鐘（0–1440）" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CooldownMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="冷卻分鐘" />
                        <TextBlock Text="回到未觸發區後再次突破才提醒；冷卻期間的突破不補發。" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShortTermAlertEditorViewModel}">
                <StackPanel Margin="0,16,0,0">
                    <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="比較區間 · 分鐘（1–60）" TextWrapping="Wrap" Margin="0,0,0,6" /><TextBox Text="{Binding WindowMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label, StringFormat={}{0}區間分鐘}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="門檻 · %（正數）" Margin="0,0,0,6" /><TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label, StringFormat={}{0}門檻百分比}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="與指定分鐘前有效報價比較；斷線後重新累積。門檻留空可停用。" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,8,0,12" />
                    <ContentControl Content="{Binding Policy}" />
                    <Button Content="{Binding Label, StringFormat=重設{0}}" Command="{Binding ResetCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="價格警示" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource SettingsAccent}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="各條件獨立；預設單次，或選擇可重複與冷卻時間。" Foreground="{DynamicResource SettingsMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Button Content="查看提醒紀錄" Click="HistoryClicked" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="AlertErrorText" Text="{Binding Error}" Foreground="{DynamicResource ThemeError}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="84" IsCancel="True" Click="CancelClicked" Margin="0,0,12,0" />
                    <Button Content="儲存" MinWidth="96" Style="{StaticResource SettingsPrimaryButton}" IsDefault="True" Click="SaveClicked" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="上限價格 · USDT" />
                    <TextBlock Grid.Column="1" Text="{Binding UpperStatus}" Foreground="{DynamicResource SettingsMuted}" />
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="UpperPriceInput" Text="{Binding UpperPriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="上限價格" ToolTip="正數，小數點使用 .；留空停用" />
                    <Button Grid.Column="2" Content="重設上限" Command="{Binding ResetUpperCommand}" />
                </Grid>
                <ContentControl Content="{Binding UpperPolicy}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="下限價格 · USDT" />
                    <TextBlock Grid.Column="1" Text="{Binding LowerStatus}" Foreground="{DynamicResource SettingsMuted}" />
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="LowerPriceInput" Text="{Binding LowerPriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="下限價格" ToolTip="正數，小數點使用 .；留空停用" />
                    <Button Grid.Column="2" Content="重設下限" Command="{Binding ResetLowerCommand}" />
                </Grid>
                <ContentControl Content="{Binding LowerPolicy}" />
                <ContentControl Content="{Binding Rise}" />
                <ContentControl Content="{Binding Fall}" Margin="0,0,0,20" />
                <Button Content="重設此幣種提醒" Command="{Binding ResetBothCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="留空可停用該條件；價格及重設操作按「儲存」後生效。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SettingsMuted}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
