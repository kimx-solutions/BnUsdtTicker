<Window x:Class="BinanceTicker.Views.MarketDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BinanceTicker.Controls"
        Title="行情詳情" Icon="/BinanceTicker;component/Assets/app.ico"
        Width="520" Height="600" MinWidth="380" MinHeight="340"
        WindowStartupLocation="Manual" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style x:Key="StatLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
            <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeError}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="重試走勢" Command="{Binding RetryCommand}" Margin="0,0,12,0" />
                <Button Content="開啟 Binance 現貨" Command="{Binding OpenTradeCommand}" Style="{StaticResource SettingsPrimaryButton}" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel>
            <TextBlock Text="{Binding Row.Symbol}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="現貨行情 · Binance" Foreground="{DynamicResource SettingsMuted}" Margin="0,6,0,20" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Row.PriceText}" FontSize="28" FontFamily="Consolas" />
                <TextBlock Text="USDT" Foreground="{DynamicResource SettingsMuted}" Margin="10,0,0,4" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="{Binding Row.QuoteStatusText}" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Row.UpdatedText}" Foreground="{DynamicResource SettingsMuted}" FontSize="11" Margin="0,4,0,18" />
            <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="價格走勢 · 1 分鐘收盤價" Foreground="{DynamicResource SettingsMuted}" FontSize="11" />
                    <controls:SparklineControl Series="{Binding Row.Series}" Height="120" Margin="0,12,0,8" AutomationProperties.Name="所選時段價格走勢" />
                    <Grid>
                        <TextBlock Text="{Binding Row.Series.Start.LocalDateTime, StringFormat={}{0:MM/dd HH:mm}}" Foreground="{DynamicResource SettingsMuted}" FontSize="10" />
                        <TextBlock Text="{Binding Row.Series.End.LocalDateTime, StringFormat={}{0:MM/dd HH:mm}}" Foreground="{DynamicResource SettingsMuted}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding Row.HistoryStatusText}" Foreground="{DynamicResource ThemeWarning}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="24h 漲跌幅" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Row.ChangeText}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,18">
                    <TextBlock Text="24h 成交額" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Row.QuoteVolumeText}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock Text="24h 最高 · USDT" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Row.HighPriceText}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,18">
                    <TextBlock Text="24h 最低 · USDT" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Row.LowPriceText}" Style="{StaticResource StatValue}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                    <TextBlock Text="24h 成交量" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding Row.VolumeText}" Style="{StaticResource StatValue}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
