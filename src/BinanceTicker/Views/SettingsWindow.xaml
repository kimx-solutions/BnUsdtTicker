<Window x:Class="BinanceTicker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Binance Ticker 設定" Icon="/BinanceTicker;component/Assets/app.ico" Width="550" Height="760" MinHeight="320" MinWidth="400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="28,24,28,24">
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="正在驗證交易對…" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource SettingsAccent}" Margin="0,0,0,8" />
                <TextBlock x:Name="SettingsErrorText" Text="{Binding Error}" Foreground="{DynamicResource ThemeError}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" MinWidth="84" IsCancel="True" Click="CancelClicked" Margin="0,0,12,0" />
                    <Button Content="儲存" MinWidth="96" Style="{StaticResource SettingsPrimaryButton}" IsDefault="True" IsEnabled="{Binding CanSave}" Click="SaveClicked" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
            <StackPanel>
                <TextBlock Text="BINANCE / USDT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsAccent}" Margin="0,0,0,8" />
                <TextBlock Text="監控幣種" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="勾選啟用，選取後可排序或刪除。" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMuted}" Margin="0,8,0,16" />
                <Grid Height="38" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged}" ToolTip="輸入 BTC、ETH 或 BTCUSDT">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}" /></TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content="＋ 新增" Command="{Binding AddCommand}" MinWidth="84" />
                </Grid>
                <Grid Height="160">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SettingsInput}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedSymbol}" PreviewMouseDown="SelectSymbolRow"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SettingsText}" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Symbol}" IsChecked="{Binding Enabled, Mode=TwoWay}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Button Content="↑ 上移" Command="{Binding MoveUpCommand}" Margin="0,0,0,10" />
                        <Button Content="↓ 下移" Command="{Binding MoveDownCommand}" Margin="0,0,0,10" />
                        <Button Content="刪除" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="0,1,0,0" Margin="0,18,0,14" />
                <TextBlock Text="顯示設定" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBlock Text="顯示模式" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                </Grid>
                <TextBlock Text="Fix：保持最上層 · Float：失去焦點即隱藏" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SettingsMuted}" Margin="0,0,0,12" />
                <CheckBox Content="啟動時顯示報價" IsChecked="{Binding ShowOnStartup}" Margin="0,0,0,10" />
                <CheckBox Content="顯示 24 小時漲跌幅" IsChecked="{Binding ShowChangePercent}" Margin="0,0,0,10" />
                <CheckBox Content="緊湊列高" IsChecked="{Binding CompactMode}" Margin="0,0,0,12" />
                <CheckBox Content="顯示價格走勢" IsChecked="{Binding ShowSparkline}" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBlock Text="走勢範圍" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SparklineRanges}" SelectedItem="{Binding SparklineRange}" AutomationProperties.Name="走勢範圍" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="不透明度" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Foreground="{DynamicResource SettingsAccent}" FontFamily="Consolas" VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" Value="{Binding Opacity}" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
