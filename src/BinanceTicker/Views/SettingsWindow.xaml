<Window x:Class="BinanceTicker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Binance Ticker 設定" Width="490" Height="650" MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft JhengHei" Background="#F5F6F8">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" IsCancel="True" Click="CancelClicked" />
            <Button Content="儲存" IsDefault="True" IsEnabled="{Binding CanSave}" Click="SaveClicked" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="200" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="監控幣種" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Binance 現貨 / USDT · 勾選啟用，選取後可排序或刪除" TextWrapping="Wrap" Foreground="#606775" Margin="0,8,0,16" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="＋ 新增" Command="{Binding AddCommand}" />
            <TextBox Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged}" Padding="8" ToolTip="輸入 BTC、ETH 或 BTCUSDT" VerticalContentAlignment="Center">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}" /></TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedSymbol}" PreviewMouseDown="SelectSymbolRow" Background="White" BorderBrush="#D9DEE7" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Symbol}" IsChecked="{Binding Enabled, Mode=TwoWay}" Padding="4,7" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="↑ 上移" Command="{Binding MoveUpCommand}" Margin="0,0,0,8" />
                <Button Content="↓ 下移" Command="{Binding MoveDownCommand}" Margin="0,0,0,8" />
                <Button Content="刪除" Command="{Binding RemoveCommand}" Margin="0" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="顯示模式" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox Width="100" HorizontalAlignment="Left" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
            </DockPanel>
            <TextBlock Text="Fix：保持最上層　Float：失去焦點即隱藏" FontSize="11" Foreground="#606775" Margin="0,0,0,12" />
            <CheckBox Content="啟動時顯示報價" IsChecked="{Binding ShowOnStartup}" Margin="0,0,0,8" />
            <CheckBox Content="顯示 24 小時漲跌幅" IsChecked="{Binding ShowChangePercent}" Margin="0,0,0,8" />
            <CheckBox Content="緊湊列高" IsChecked="{Binding CompactMode}" Margin="0,0,0,8" />
            <DockPanel>
                <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,10,0,12">
            <TextBlock Text="正在驗證交易對…" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="#606775" />
            <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
