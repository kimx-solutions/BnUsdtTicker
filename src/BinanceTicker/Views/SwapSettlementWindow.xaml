<Window x:Class="BinanceTicker.Views.SwapSettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Icon="/BinanceTicker;component/Assets/app.ico"
        Width="590" Height="700" MinWidth="420" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft JhengHei" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SettingsText}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource SettingsText}" />
                <Setter Property="Margin" Value="0,0,20,0" /><Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeNegative}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Content="確認結算" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimaryButton}" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsEnabled="{Binding EditorEnabled}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,8" />
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Label}" Margin="0,0,0,20" />
                <TextBlock Text="結算方式" Style="{StaticResource Label}" />
                <WrapPanel Margin="0,4,0,12">
                    <RadioButton Content="實際成交" GroupName="Mode" IsChecked="{Binding IsActual}" />
                    <RadioButton Content="當下報價" GroupName="Mode" IsChecked="{Binding UseMarketQuote}" />
                </WrapPanel>
                <TextBlock Text="實際成交以你填的到帳數量為準；當下報價會保存確認時的報價與計算結果。" Style="{StaticResource Label}" Margin="0,0,0,18" />
                <CheckBox Content="全部結算剩餘數量" IsChecked="{Binding SettleAll}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding QuantityLabel}" Style="{StaticResource Label}" />
                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditQuantity}" AutomationProperties.Name="結算數量" />
                <StackPanel Visibility="{Binding IsActual, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ReturnLabel}" Style="{StaticResource Label}" />
                    <TextBox x:Name="ActualReturnInput" Text="{Binding ActualReturnText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="實際換回數量" />
                    <TextBlock Text="{Binding PriceLabel}" Style="{StaticResource Label}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding FromPriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="結算參考價" />
                    <TextBlock Text="留空仍會保留原幣差額與報酬率，USDT 差額顯示 —。" Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
                <Border Background="{DynamicResource SettingsSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,14">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="結算備註（選填）" Style="{StaticResource Label}" />
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="結算備註" />
                <TextBlock Text="全部結算後會移到歷史區，保存每次結算明細。已有結算明細的原始紀錄無法編輯。" Style="{StaticResource Label}" FontSize="11" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
