<Window x:Class="BinanceTicker.Views.TickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BinanceTicker.Core.Models;assembly=BinanceTicker.Core"
        xmlns:vm="clr-namespace:BinanceTicker.Core.ViewModels;assembly=BinanceTicker.Core"
        Title="Binance USDT Ticker" Width="390" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Icon="/BinanceTicker;component/Assets/app.ico" FontFamily="Segoe UI, Microsoft JhengHei"
        Foreground="#F3F4F6" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="SortHeader" TargetType="Button">
            <Setter Property="AutomationProperties.HelpText" Value="{Binding SortDescription}" />
            <Setter Property="Foreground" Value="#8B95A5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="Transparent" CornerRadius="3">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#36D9F5" /><Setter TargetName="Frame" Property="Background" Value="#12384B" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#36D9F5" /><Setter TargetName="Frame" Property="Background" Value="#12384B" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#A8B0BD" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="6,4" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TickerRow" TargetType="Border">
            <Setter Property="Padding" Value="0,13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="0,7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="#171B22" BorderBrush="#353B46" BorderThickness="1" CornerRadius="12" Padding="18,12">
        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#F0B90B" Margin="0,0,8,0" />
                    <TextBlock Text="USDT TICKER" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource HeaderButton}" Content="⚙" ToolTip="設定" Click="SettingsClicked" />
                    <Button Style="{StaticResource HeaderButton}" Content="✕" ToolTip="隱藏報價（程式繼續常駐）" Click="HideClicked" />
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Border Padding="4" Background="Transparent" ToolTip="{Binding ModeText}" AutomationProperties.Name="{Binding ModeText}">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#8B95A5" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style><Style TargetType="Path">
                                    <Setter Property="Data" Value="M7,4 L20,4 L20,17 L7,17 Z M4,8 L4,20 L16,20" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModeText}" Value="FIX">
                                            <Setter Property="Data" Value="M6,3 L18,3 M8,3 L8,10 L5,14 L19,14 L16,10 L16,3 M12,14 L12,21" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Padding="4" Margin="6,0,0,0" Background="Transparent" ToolTip="{Binding StatusText}" AutomationProperties.Name="{Binding StatusText}">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style><Style TargetType="Path">
                                    <Setter Property="Data" Value="M3,8 Q12,-1 21,8 M6,12 Q12,6 18,12 M9,16 Q12,13 15,16 M12,20 L12,20.1" />
                                    <Setter Property="Stroke" Value="#F0B90B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionStatus.Connected}">
                                            <Setter Property="Stroke" Value="#54CBA2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ConnectionStatus.Disconnected}">
                                            <Setter Property="Stroke" Value="#F07883" />
                                            <Setter Property="Data" Value="M3,8 Q12,-1 21,8 M6,12 Q12,6 18,12 M12,20 L12,20.1 M3,3 L21,21" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Stroke" Value="#8B95A5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Border>
            </StackPanel>
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding SymbolSortHeader}" Command="{Binding SortSymbolCommand}" HorizontalContentAlignment="Left" ToolTip="依幣種排序；再次點擊切換升冪／降冪" AutomationProperties.Name="幣種排序">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SortHeader}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SortColumn}" Value="{x:Static vm:TickerSortColumn.Symbol}"><Setter Property="Foreground" Value="#36D9F5" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Grid.Column="1" Content="{Binding PriceSortHeader}" Command="{Binding SortPriceCommand}" HorizontalContentAlignment="Right" ToolTip="依價格排序；再次點擊切換升冪／降冪" AutomationProperties.Name="價格排序">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SortHeader}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SortColumn}" Value="{x:Static vm:TickerSortColumn.Price}"><Setter Property="Foreground" Value="#36D9F5" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Grid.Column="2" Content="{Binding ChangeSortHeader}" Command="{Binding SortChangeCommand}" HorizontalContentAlignment="Right" ToolTip="依 24 小時漲跌幅排序；再次點擊切換升冪／降冪" AutomationProperties.Name="24 小時漲跌幅排序" Visibility="{Binding ShowChangePercent, Converter={StaticResource BoolVisibility}}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SortHeader}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SortColumn}" Value="{x:Static vm:TickerSortColumn.ChangePercent}"><Setter Property="Foreground" Value="#36D9F5" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="尚未啟用幣種，請開啟設定新增。" Margin="0,20" Foreground="#A8B0BD" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                    <ItemsControl ItemsSource="{Binding Prices}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource TickerRow}" BorderBrush="#282E38" BorderThickness="0,0,0,1" ToolTip="{Binding UpdatedText}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Asset}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontFamily="Consolas" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ChangeText}" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding DataContext.ShowChangePercent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F07883" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPositive}" Value="True"><Setter Property="Foreground" Value="#54CBA2" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasPrice}" Value="False"><Setter Property="Foreground" Value="#8B95A5" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
